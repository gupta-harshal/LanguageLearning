// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String     @unique
  password  String
  createdAt DateTime   @default(now())

  stats     UserStats? @relation("UserToStats")
  srs       UserSrs?   @relation("UserToSrs")
}

model UserStats {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @unique @db.ObjectId
  user          User     @relation("UserToStats", fields: [userId], references: [id])
  streak        Int      @default(0)
  longestStreak Int      @default(0)
  practiceDays  Int      @default(0)
  xp            Int      @default(0)
  level         Int      @default(1)
  lastActiveDay String? // YYYY-MM-DD UTC
}

// Central spaced-repetition state (FSRS scheduler JSON from Python service)
model UserSrs {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @unique @db.ObjectId
  user       User     @relation("UserToSrs", fields: [userId], references: [id])
  experience Int      @default(0) // 0..2 maps to Python initialize
  maxTimeMin Int      @default(15) // 10 | 15 | 20
  scheduler  Json?
  completed  Json // { [wordId]: Card.to_dict() }
  updatedAt  DateTime @updatedAt
}
