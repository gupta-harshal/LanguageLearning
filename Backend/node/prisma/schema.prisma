// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String     @unique
  password  String
  createdAt DateTime   @default(now())

  stats          UserStats?          @relation("UserToStats")
  srs            UserSrs?            @relation("UserToSrs")
  journal        VocabJournal[]      @relation("UserToJournal")
  storyProgress  UserStoryProgress[] @relation("UserToStoryProgress")
}

model UserStats {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @unique @db.ObjectId
  user          User     @relation("UserToStats", fields: [userId], references: [id])
  streak        Int      @default(0)
  longestStreak Int      @default(0)
  practiceDays  Int      @default(0)
  xp            Int      @default(0)
  level         Int      @default(1)
  lastActiveDay String?
  badges        String[] @default([])
  shadowBest    Int      @default(0) // best shadowing accuracy 0-100
  sourceXp      Json? // { srs: 120, talk: 40, ... } feeds the skill tracker
}

model UserSrs {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @unique @db.ObjectId
  user       User     @relation("UserToSrs", fields: [userId], references: [id])
  experience Int      @default(0)
  maxTimeMin Int      @default(15)
  scheduler  Json?
  completed  Json
  updatedAt  DateTime @updatedAt
}

model VocabJournal {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation("UserToJournal", fields: [userId], references: [id])
  word      String
  reading   String   @default("")
  meaning   String   @default("")
  source    String   @default("manual") // talk | srs | game | listen | manual
  mastered  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

/** Levelled Japanese readers. sentences = [{ ja, reading, en }] */
model Story {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  slug      String   @unique
  level     Int // 1 (N5) … 5 (N3+)
  order     Int      @default(0)
  titleJa   String
  titleEn   String
  summary   String   @default("")
  theme     String   @default("everyday")
  sentences Json // StorySentence[]
  createdAt DateTime @default(now())

  progress UserStoryProgress[] @relation("StoryToProgress")

  @@index([level])
}

model UserStoryProgress {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId
  user          User     @relation("UserToStoryProgress", fields: [userId], references: [id])
  storyId       String   @db.ObjectId
  story         Story    @relation("StoryToProgress", fields: [storyId], references: [id])
  sentenceIndex Int      @default(0)
  completed     Boolean  @default(false)
  bestScore     Int      @default(0) // best read-aloud accuracy
  updatedAt     DateTime @updatedAt

  @@unique([userId, storyId])
  @@index([userId])
}
